// Cloudflare settings. See README "Deploy to Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudika-po-website",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["python_workers"],

  // CSS, JavaScript and the logo are served straight from the public/ folder
  "assets": {
    "directory": "./public"
  },

  // The database. Replace database_id with the ID shown in the Cloudflare dashboard
  // (Storage & Databases > D1 > mudika-po).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mudika-po",
      "database_id": "30e30166-1ef3-47ff-8cd7-44bb55c0fa9e"
    }
  ],

  // Lets you see errors under Workers & Pages > mudika-po-website > Logs
  "observability": {
    "enabled": true
  }
}
