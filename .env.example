# Copy this file to ".env" (same folder) and fill in your own values.
# .env is never uploaded to GitHub. On Cloudflare, add the same names under
# Workers & Pages > mudika-po-website > Settings > Variables and Secrets.

# Password for the /admin page
ADMIN_PASSWORD=change-me

# Keeps logins secure. Any long random text (e.g. mash the keyboard for 40+ characters)
FLASK_SECRET_KEY=replace-with-long-random-text

# Google Sheet copy (optional; see README "Connect the Google Sheet")
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
